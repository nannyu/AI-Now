JWT_SECRET="replace-with-at-least-32-random-characters"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Enable only for local development when your feed service runs on localhost
ALLOW_PRIVATE_FEED_URLS="true"

# wechat-rss-lite (run: npm run wechat-rss:dev)
WECHAT_RSS_BASE_URL="http://127.0.0.1:8081"
# Same value as services/wechat-rss-lite/.env ADMIN_API_TOKEN (optional; auto-injected for admin proxy + fetch)
WECHAT_RSS_ADMIN_TOKEN=""
